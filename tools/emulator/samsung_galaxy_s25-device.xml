<?xml version="1.0" encoding="UTF-8"?>
<d:devices xmlns:d="http://schemas.android.com/sdk/devices/8">

    <d:device>
        <d:name>Samsung Galaxy S25</d:name>
        <d:id>samsung_galaxy_s25</d:id>
        <d:manufacturer>Samsung</d:manufacturer>
        <d:playstore-enabled>false</d:playstore-enabled>
        <d:hardware>
            <d:screen>
                <d:screen-size>normal</d:screen-size>
                <d:diagonal-length>6.2</d:diagonal-length>
                <d:pixel-density>420dpi</d:pixel-density>
                <d:screen-ratio>long</d:screen-ratio>
                <d:dimensions>
                    <d:x-dimension>1080</d:x-dimension>
                    <d:y-dimension>2340</d:y-dimension>
                </d:dimensions>
                <d:xdpi>416</d:xdpi>
                <d:ydpi>416</d:ydpi>
                <d:touch>
                    <d:multitouch>jazz-hands</d:multitouch>
                    <d:mechanism>finger</d:mechanism>
                    <d:screen-type>capacitive</d:screen-type>
                </d:touch>
            </d:screen>
            <d:networking>Wifi Bluetooth NFC</d:networking>
            <d:sensors>Accelerometer Barometer Compass GPS Gyroscope LightSensor ProximitySensor StepCounter StepDetector Fingerprint</d:sensors>
            <d:mic>true</d:mic>
            <d:camera>
                <d:location>back</d:location>
                <d:autofocus>true</d:autofocus>
                <d:flash>true</d:flash>
            </d:camera>
            <d:camera>
                <d:location>front</d:location>
                <d:autofocus>true</d:autofocus>
                <d:flash>false</d:flash>
            </d:camera>
            <d:keyboard>nokeys</d:keyboard>
            <d:nav>nonav</d:nav>
            <d:ram unit="MiB">8192</d:ram>
            <d:buttons>soft</d:buttons>
            <d:internal-storage unit="MiB">8192</d:internal-storage>
            <d:removable-storage unit="MiB">0</d:removable-storage>
            <d:cpu>Qualcomm Snapdragon 8 Elite</d:cpu>
            <d:gpu>Qualcomm Adreno 830</d:gpu>
            <d:abis>
                arm64-v8a
            </d:abis>
            <d:dock> </d:dock>
            <d:power-type>battery</d:power-type>
            <d:skin>samsung_galaxy_s25</d:skin>
        </d:hardware>
        <d:software>
            <d:api-level>35-</d:api-level>
            <d:live-wallpaper-support>true</d:live-wallpaper-support>
            <d:bluetooth-profiles> </d:bluetooth-profiles>
            <d:gl-version>3.2</d:gl-version>
            <d:gl-extensions>GL_EXT_debug_marker GL_OES_EGL_image GL_OES_EGL_image_external GL_OES_depth24 GL_OES_rgb8_rgba8 GL_KHR_texture_compression_astc_ldr GL_EXT_color_buffer_float GL_EXT_texture_filter_anisotropic</d:gl-extensions>
            <d:status-bar>true</d:status-bar>
        </d:software>
        <d:state name="Portrait" default="true">
            <d:description>The device in portrait view</d:description>
            <d:screen-orientation>port</d:screen-orientation>
            <d:keyboard-state>keyssoft</d:keyboard-state>
            <d:nav-state>nonav</d:nav-state>
        </d:state>
        <d:state name="Landscape">
            <d:description>The device in landscape view</d:description>
            <d:screen-orientation>land</d:screen-orientation>
            <d:keyboard-state>keyssoft</d:keyboard-state>
            <d:nav-state>nonav</d:nav-state>
        </d:state>
    </d:device>

</d:devices>
